#!/usr/bin/env bash
# clipspan: two-way clipboard sync between this Linux machine and a Mac over SSH.
#
# Linux -> Mac: two wl-paste --watch processes (text and PNG) push every clipboard
#   change to `Clipspan set` on the Mac.
# Mac -> Linux: one long-lived SSH session runs `Clipspan stream`, which prints a
#   line ("t:<base64 text>" or "i:<base64 png>") whenever the Mac clipboard
#   changes. Nothing polls from this side, so idle cost is close to zero.
# A shared "last" file records whatever was synced most recently, in either
# direction, so nothing bounces back and forth.
#
# Configuration (environment, normally set in the systemd unit by install.sh):
#   CLIPSPAN_HOST   SSH host name of the Mac (required)
#   CLIPSPAN_APP    path of the Clipspan binary on the Mac, relative to its home
#                   (default: Applications/Clipspan.app/Contents/MacOS/Clipspan)
set -u
HOST="${CLIPSPAN_HOST:-}"
APP="${CLIPSPAN_APP:-Applications/Clipspan.app/Contents/MacOS/Clipspan}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/clipspan"
MAX_BYTES=20971520   # 20 MB, matches the cap in the Mac app

if [ -z "$HOST" ]; then
  echo "clipspan: CLIPSPAN_HOST is not set; run linux/install.sh <mac-ssh-host>" >&2
  exit 1
fi

mkdir -p "$STATE"
LAST="$STATE/last"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
     -o ControlMaster=auto -o ControlPath="$STATE/ssh-%C" -o ControlPersist=300 "$HOST")

# Called by wl-paste --watch with the new clipboard contents on stdin.
if [ "${1:-}" = "--push" ]; then
  [ "${CLIPBOARD_STATE:-}" = "sensitive" ] && exit 0   # password-manager copies stay local
  cat > "$STATE/local"
  [ -s "$STATE/local" ] || exit 0
  [ "$(stat -c %s "$STATE/local")" -le "$MAX_BYTES" ] || exit 0
  cmp -s "$STATE/local" "$LAST" && exit 0
  cp "$STATE/local" "$LAST"
  "${SSH[@]}" "$APP" set < "$STATE/local"
  exit 0
fi

: > "$LAST"
wl-paste -n --type text/plain --watch "$0" --push &
WATCH_TEXT=$!
wl-paste --type image/png --watch "$0" --push &
WATCH_IMAGE=$!
trap 'kill $WATCH_TEXT $WATCH_IMAGE 2>/dev/null; "${SSH[@]}" -O exit 2>/dev/null; exit 0' INT TERM

# `Clipspan stream` exits when its stdin closes (that is how it notices a dropped
# SSH session), so feed it a fifo that stays open instead of systemd's /dev/null.
rm -f "$STATE/keepalive"; mkfifo "$STATE/keepalive"; exec 3<>"$STATE/keepalive"

while :; do
  "${SSH[@]}" "$APP" stream <&3 | while IFS= read -r line; do
    printf '%s' "${line#??}" | base64 -d > "$STATE/remote" || continue
    [ -s "$STATE/remote" ] || continue
    cmp -s "$STATE/remote" "$LAST" && continue
    cp "$STATE/remote" "$LAST"
    case "$line" in
      t:*) wl-copy < "$STATE/remote" ;;
      i:*) wl-copy --type image/png < "$STATE/remote" ;;
    esac
  done
  sleep 10   # Mac unreachable or asleep: try again shortly
done
